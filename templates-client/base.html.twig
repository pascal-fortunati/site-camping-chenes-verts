<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site.nom|default('Site') }}{% endblock %}</title>
    {# Passed in rather than recomputed: the preview title must be the title. #}
    {% include 'partials/meta-sociales.html.twig' with { titrePartage: block('title') } %}
    {% block head %}{% endblock %}
    {# Les deux polices du titre et du texte, préchargées : elles servent dès le premier écran. #}
    <link rel="preload" href="/assets/fonts/lexend-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/css/site.css">
    {# This site's own styles, loaded after so they take precedence. Edit that
       file rather than site.css: an update never touches it. #}
    <link rel="stylesheet" href="/assets/css/client.css">
    {# The customer's colours, written to a file so the content policy can
       keep refusing inline styles. #}
    {# Versionnée par les couleurs de l'identité : un changement s'affiche tout de suite, malgré l'heure de cache des CSS. #}
    <link rel="stylesheet" href="/assets/css/couleurs.css?v={{ (site.couleurPrincipale|default('') ~ site.couleurTexte|default(''))|replace({'#': ''})|url_encode }}">
    {# Menu repliable au téléphone. Sans JavaScript, le menu reste déplié. #}
    <script src="/assets/js/menu.js" defer></script>
    <script src="/assets/js/remonter.js" defer></script>
    <script src="/assets/js/passerelle.js" defer></script>
    {% if jsonld|default('') is not empty %}
        {# Built and encoded in PHP, so it is inserted as is. #}
        <script type="application/ld+json">{{ jsonld|raw }}</script>
    {% endif %}
</head>
<body id="haut">

<a class="lien-evitement" href="#contenu">Aller au contenu</a>

<header class="en-tete">
    <div class="en-tete__interieur">

        {# Le nom est écrit en toutes lettres : le badge du logo reste une
           image décorative, pour ne pas lire le nom deux fois. #}
        <a class="en-tete__logo" href="/">
            {% if site.logo|default(null) %}
                {% include 'partials/image.html.twig' with {
                    asset: site.logo,
                    alt: '',
                    sizes: '64px',
                    eager: true
                } only %}
            {% endif %}
            <span class="en-tete__nom">
                {%- set nom = site.nom|default('Site') -%}
                {%- if nom starts with 'Camping ' -%}
                    <span class="en-tete__type">Camping</span> {{ nom|slice(8) }}
                {%- else -%}
                    {{ nom }}
                {%- endif -%}
            </span>
        </a>

        {# Toujours visible au téléphone : c'est l'objectif du site. À l'ordinateur,
           l'entrée « Réserver » du menu prend l'apparence d'un bouton. #}
        <a class="bouton en-tete__reserver" href="/reserver">Réserver</a>

        {% if menu|default([]) is not empty or afficherActualites|default(false) %}
            <button class="menu__bouton" type="button" aria-expanded="false" aria-controls="menu">
                <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><rect x="2" y="4" width="16" height="2" rx="1" fill="currentColor"/><rect x="2" y="9" width="16" height="2" rx="1" fill="currentColor"/><rect x="2" y="14" width="16" height="2" rx="1" fill="currentColor"/></svg>
                <span class="menu__bouton-texte">Menu</span>
            </button>

            <nav class="menu" id="menu" aria-label="Menu principal">
                <ul class="menu__liste">
                    {% for entree in menu %}
                        {% set adresse = entree.slug == accueilSlug|default('accueil') ? '/' : '/' ~ entree.slug %}
                        <li>
                            <a href="{{ adresse }}"{% if entree.slug == slug|default(null) %} aria-current="page"{% endif %}>{{ entree.libelle }}</a>
                        </li>
                    {% endfor %}

                    {# Added on its own as soon as something is published there:
                       an empty news section would be worse than none. #}
                    {% if afficherActualites|default(false) %}
                        <li>
                            <a href="/actualites"{% if slug|default(null) == 'actualites' %} aria-current="page"{% endif %}>Actualités</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}

    </div>
</header>

<main id="contenu">
    {% block main %}{% endblock %}
</main>

{% include 'partials/pied.html.twig' %}

{# Revenir en haut : un gland et ses feuilles de chêne ; les feuilles bougent au défilement (remonter.js). #}
<a class="remonter" href="#haut" aria-label="Revenir en haut de la page" title="Revenir en haut">
    <svg class="remonter__gland" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <g class="remonter__feuille remonter__feuille--gauche">
            <g transform="translate(31 22) rotate(-48)">
                <path d="M0 0C-4-4-9-3-8-8C-12-9-12-14-7-14C-11-17-9-22-4-20C-5-25-1-28 0-28C1-28 5-25 4-20C9-22 11-17 7-14C12-14 12-9 8-8C9-3 4-4 0 0Z" fill="#4F8A3A" class="remonter__limbe"/>
                <path d="M0 0V-24" stroke="#2E5E22" stroke-width="1.2" fill="none" class="remonter__nervure"/>
            </g>
        </g>
        <g class="remonter__feuille remonter__feuille--droite">
            <g transform="translate(33 22) rotate(42) scale(.9)">
                <path d="M0 0C-4-4-9-3-8-8C-12-9-12-14-7-14C-11-17-9-22-4-20C-5-25-1-28 0-28C1-28 5-25 4-20C9-22 11-17 7-14C12-14 12-9 8-8C9-3 4-4 0 0Z" fill="#6FA34F" class="remonter__limbe"/>
                <path d="M0 0V-24" stroke="#3E7A2C" stroke-width="1.2" fill="none" class="remonter__nervure"/>
            </g>
        </g>
        <path d="M22 33C22 46 28 54 32 57C36 54 42 46 42 33Z" fill="#C9A27A"/>
        <path d="M27 36C26 44 29 50 32 53" stroke="#E2C59E" stroke-width="2" fill="none" stroke-linecap="round"/>
        <rect x="31" y="17" width="2.4" height="8" rx="1.2" fill="#6E4220"/>
        <path d="M18 34C18 23 46 23 46 34C42 36 22 36 18 34Z" fill="#6E4220"/>
        <path d="M22 29H42M20 32H44M25 26H39M26 25L22 34M32 24V35M38 25L42 34" stroke="#8A5A2E" stroke-width="1" fill="none"/>
    </svg>
</a>

</body>
</html>
